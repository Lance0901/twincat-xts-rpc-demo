<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_InitStepName" Id="{5cba7baa-72b8-4c3a-bd57-7406ef716537}" SpecialFunc="None">
    <Declaration><![CDATA[// 初始化步驟名稱，給 sInitMsg 用
FUNCTION F_InitStepName : STRING
VAR_INPUT
    eStep : E_InitStep;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE eStep OF
E_InitStep.Idle:            F_InitStepName := 'Idle';
E_InitStep.Reset:           F_InitStepName := 'Reset';
E_InitStep.InitEnvironment: F_InitStepName := 'InitEnvironment';
E_InitStep.WaitMovers:      F_InitStepName := 'WaitMovers';
E_InitStep.FindMover1:      F_InitStepName := 'FindMover1';
E_InitStep.FindMover1Wait:  F_InitStepName := 'FindMover1Wait';
E_InitStep.PowerOn:         F_InitStepName := 'PowerOn';
E_InitStep.EnableGroup:     F_InitStepName := 'EnableGroup';
E_InitStep.Ready:           F_InitStepName := 'Ready';
E_InitStep.Error:           F_InitStepName := 'Error';
ELSE
    F_InitStepName := 'Unknown';
END_CASE]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>