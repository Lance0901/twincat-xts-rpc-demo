<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_CycleState" Id="{9ad52bc6-bfdb-4cc3-b0ae-39786127ce10}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_CycleState :
(
    Idle := 0,
    ToStation := 10,    // mover 往 nCycleStation 移動
    InStation := 20,    // 站動作中
    Done := 100,        // 一輪完成
    Stopped := 800,     // 被 M_Stop 中止
    Error := 900
) INT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>